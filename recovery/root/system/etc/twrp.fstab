# Dynamic Partitions (Logical)
/system         auto    /dev/block/mapper/system        flags=display="System";backup=1;logical;wipeingui=1
/vendor         auto    /dev/block/mapper/vendor        flags=display="Vendor";backup=1;logical;wipeingui=1
/product        auto    /dev/block/mapper/product       flags=display="Product";backup=1;logical;wipeingui=1
/odm            auto    /dev/block/mapper/odm           flags=display="Odm";backup=1;logical;wipeingui=1

/system_image   emmc    /dev/block/mapper/system        flags=display="System Image";backup=0;flashimg=1;logical
/vendor_image   emmc    /dev/block/mapper/vendor        flags=display="Vendor Image";backup=0;flashimg=1;logical
/product_image  emmc    /dev/block/mapper/product       flags=display="Product Image";backup=0;flashimg=1;logical
/odm_image      emmc    /dev/block/mapper/odm           flags=display="Odm Image";backup=0;flashimg=1;logical

# Physical Partitions
/boot           emmc    /dev/block/by-name/boot         flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/by-name/recovery     flags=display="Recovery";backup=1;flashimg=1

/metadata       ext4    /dev/block/by-name/metadata     flags=display="Metadata";wipeingui
/data           f2fs    /dev/block/by-name/userdata     flags=display="Data";wipeingui
/cache          ext4    /dev/block/by-name/cache        flags=display="Cache";wipeingui

/efs            ext4    /dev/block/by-name/efs          flags=display="EFS";backup=1
/sec_efs        ext4    /dev/block/by-name/sec_efs      flags=display="Sec EFS";backup=1

/modem          emmc    /dev/block/by-name/radio        flags=display="Modem";backup=1
/misc           emmc    /dev/block/by-name/misc

/dtbo           emmc    /dev/block/by-name/dtbo         flags=display="DTBO Image";flashimg=1;backup=1
/dtb            emmc    /dev/block/by-name/dtb          flags=display="DTB Image";flashimg=1;backup=1

/optics         ext4    /dev/block/by-name/optics       flags=display="Optics";backup=0
/prism          ext4    /dev/block/by-name/prism        flags=display="Prism";backup=0

/optics_image   emmc    /dev/block/by-name/optics       flags=display="Optics Image";backup=1;flashimg=1
/prism_image    emmc    /dev/block/by-name/prism        flags=display="Prism Image";backup=1;flashimg=1

/up_param       emmc    /dev/block/by-name/up_param     flags=display="Boot Logos";backup=1;flashimg=1

# External Storage
/external_sd    auto    /dev/block/mmcblk1p1 /dev/block/mmcblk1  flags=display="Micro SD Card";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sda1 /dev/block/sda           flags=display="USB OTG";storage;wipeingui;removable
